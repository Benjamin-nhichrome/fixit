<%- include("partials/header") %>
<h1>Dashboard</h1>
<p>Welkom, <%= user.name %></p>

<p><a href="/melding/nieuw">+ Nieuwe melding</a></p>

<h2>Mijn meldingen</h2>

<% if (!meldingen || meldingen.length === 0) { %>
  <p>Je hebt nog geen meldingen aangemaakt.</p>
<% } else { %>
  <table>
    <tr>
      <th>Datum</th>
      <th>Categorie</th>
      <th>Locatie</th>
      <th>Status</th>
    </tr>

    <% meldingen.forEach(melding => { %>
      <tr>
        <td><%= melding.datum %></td>
        <td><%= melding.categorie %></td>
        <td><%= melding.locatie %></td>
        <td class="status status-<%= (melding.status || '').toLowerCase().replace(/\s+/g,'-') %>">
          <%= melding.status %>
        </td>
      </tr>
    <% }) %>
  </table>
<% } %>

<%- include("partials/footer") %>
