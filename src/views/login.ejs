<%# Loginpagina gebruikt header met page: "login" zodat login background actief wordt. %>
<%- include("partials/header", { page: "login" }) %>

<div class="container">
  <div class="card auth-card">

    <h1>💻 FixIT ServiceDesk</h1>
    <p>Log in om storingen te melden en tickets te beheren.</p>

    <%# Toont foutmelding als login mislukt, bijvoorbeeld verkeerd wachtwoord. %>
    <% if (error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
    <% } %>

    <%# Login formulier stuurt email en wachtwoord naar POST /login. %>
    <form method="post" action="/login">

      <%# CSRF token beschermt dit formulier. %>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required />
      </div>

      <div>
        <label for="password">Wachtwoord</label>
        <input id="password" name="password" type="password" required />
      </div>

      <button type="submit">Login</button>
    </form>

    <p style="margin-top:16px;">
      <a href="/register">Account maken</a>
    </p>

  </div>
</div>

<%- include("partials/footer") %>
